# Locize project credentials. Copy to .env (gitignored) and fill in.
#
# Get these at https://www.locize.app → project → Settings.
#
# Only LOCIZE_PROJECT_ID is required for the `downloadLocales` script that
# CI / build runs use.  LOCIZE_API_KEY is only needed for `syncLocales`
# (pushing local keys back up) and must NEVER be set in production
# environments — it's a write key.

LOCIZE_PROJECT_ID=your-project-id-here
LOCIZE_API_KEY=your-dev-only-write-api-key
