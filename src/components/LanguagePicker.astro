---
import { getT, languages, pathForLang, type Lang } from '../i18n'

interface Props {
  currentLang: Lang
}

const { currentLang } = Astro.props
const t = getT(currentLang)
---

<nav aria-label={t('languagePicker.label')}>
  <ul>
    {Object.entries(languages).map(([lang, label]) => (
      <li>
        {lang === currentLang ? (
          <strong>{label}</strong>
        ) : (
          <a href={pathForLang(Astro.url.pathname, lang as Lang)}>{label}</a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 1rem; }
</style>
